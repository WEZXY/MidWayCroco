          <item row="0" column="3">
           <widget class="QFrame" name="cardLight">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QLabel" name="lblT4"><property name="text"><string>Light Intensity</string></property><property name="class" stdset="0"><string>cardTitle</string></property></widget></item>
             <item><widget class="QLabel" name="lblS4"><property name="text"><string>DataType: int16</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblLight"><property name="text"><string>-- Lux</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
