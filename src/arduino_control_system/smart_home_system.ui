          <column><property name="text"><string>Door</string></property></column>
          <column><property name="text"><string>Fan</string></property></column>
          <column><property name="text"><string>RoomLight</string></property></column>
          <column><property name="text"><string>LCD Message</string></property></column>
          <column><property name="text"><string>Code</string></property></column>
