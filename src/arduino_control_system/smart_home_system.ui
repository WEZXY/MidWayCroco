             <item><widget class="QLabel" name="lblS2"><property name="text"><string>DataType: int16</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblGas"><property name="text"><string>-- PPM</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
