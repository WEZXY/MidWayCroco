<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1100</width>
    <height>720</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Smart Home ROS / Arduino Control Center</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #000000;
    color: #FFFFFF;
    font-family: 'Segoe UI', Arial, sans-serif;
}
QTabWidget::pane {
    border: 1px solid #232323;
    background-color: #111111;
}
QTabBar::tab {
    background: #111111;
    color: #7A7A7A;
    padding: 10px 20px;
    border: 1px solid #232323;
    font-weight: bold;
}
QTabBar::tab:selected {
    background: #232323;
    color: #FFFFFF;
    border-bottom: 2px solid #696969;
}
QFrame.card {
    background-color: #111111;
    border: 1px solid #232323;
    border-radius: 8px;
}
QLabel {
    color: #FFFFFF;
}
QLabel.sectionHeader {
    font-weight: bold;
    color: #7A7A7A;
    letter-spacing: 1px;
}
QLabel.cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #FFFFFF;
}
QLabel.cardSub {
    font-size: 11px;
    color: #7A7A7A;
}
QLabel.cardValue {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
}
QPushButton.toggleBtn {
    background-color: #111111;
    color: #7A7A7A;
    border: 2px solid #343434;
    border-radius: 6px;
    padding: 12px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton.toggleBtn:hover {
    background-color: #232323;
    color: #FFFFFF;
}
QPushButton.toggleBtn:checked {
    background-color: #464646;
    color: #FFFFFF;
    border: 2px solid #7A7A7A;
}
QPushButton.actionBtn {
    background-color: #343434;
    color: #FFFFFF;
    border: 1px solid #464646;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton.actionBtn:hover {
    background-color: #464646;
}
QSlider::groove:horizontal {
    border: 1px solid #343434;
    height: 8px;
    background: #111111;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #7A7A7A;
    border: 1px solid #FFFFFF;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #FFFFFF;
}
QLineEdit, QDateEdit, QTimeEdit {
    background-color: #111111;
    border: 1px solid #343434;
    color: #FFFFFF;
    padding: 6px;
    border-radius: 4px;
}
QTableWidget {
    background-color: #111111;
    gridline-color: #232323;
    border: 1px solid #232323;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #232323;
    color: #FFFFFF;
    padding: 6px;
    border: 1px solid #343434;
    font-weight: bold;
}
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout">
    <item>
     <widget class="QTabWidget" name="tabWidget">
      <property name="currentIndex">
       <number>0</number>
      </property>

      <!-- TAB 1: DASHBOARD -->
      <widget class="QWidget" name="tabDashboard">
       <attribute name="title">
        <string>Control Dashboard</string>
       </attribute>
       <layout class="QVBoxLayout" name="dashboardLayout">
        <property name="spacing">
         <number>15</number>
        </property>
        <item>
         <widget class="QLabel" name="hdrSensors">
          <property name="text">
           <string>LIVE SENSOR READINGS</string>
          </property>
          <property name="class" stdset="0">
           <string>sectionHeader</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QGridLayout" name="gridSensors">
          <property name="spacing">
           <number>10</number>
          </property>

          <item row="0" column="0">
           <widget class="QFrame" name="cardTemp">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
