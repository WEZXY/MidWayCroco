          </item>

          <item row="1" column="0">
           <widget class="QFrame" name="cardIR">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QLabel" name="lblT5"><property name="text"><string>IR Sensor</string></property><property name="class" stdset="0"><string>cardTitle</string></property></widget></item>
             <item><widget class="QLabel" name="lblS5"><property name="text"><string>DataType: int16</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblIR"><property name="text"><string>0</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
           </widget>
          </item>

          <item row="1" column="1">
           <widget class="QFrame" name="cardPIR">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QLabel" name="lblT6"><property name="text"><string>PIR Motion</string></property><property name="class" stdset="0"><string>cardTitle</string></property></widget></item>
             <item><widget class="QLabel" name="lblS6"><property name="text"><string>Status: Disabled</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblPIR"><property name="text"><string>N/A</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
           </widget>
          </item>

          <item row="1" column="2">
           <widget class="QFrame" name="cardKeypad">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QLabel" name="lblT7"><property name="text"><string>Keypad Input</string></property><property name="class" stdset="0"><string>cardTitle</string></property></widget></item>
             <item><widget class="QLabel" name="lblS7"><property name="text"><string>DataType: int16</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblKeypad"><property name="text"><string>None</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
           </widget>
          </item>

          <item row="1" column="3">
           <widget class="QFrame" name="cardBuzzer">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QLabel" name="lblT8"><property name="text"><string>Buzzer Status</string></property><property name="class" stdset="0"><string>cardTitle</string></property></widget></item>
             <item><widget class="QLabel" name="lblS8"><property name="text"><string>DataType: bool</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblBuzzer"><property name="text"><string>OFF</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <widget class="QLabel" name="hdrActions">
          <property name="text">
           <string>ACTUATOR CONTROLS</string>
          </property>
          <property name="class" stdset="0">
           <string>sectionHeader</string>
          </property>
         </widget>
        </item>

        <item>
         <layout class="QGridLayout" name="gridActions">
          <property name="spacing">
           <number>10</number>
          </property>
          <item row="0" column="0">
           <widget class="QPushButton" name="btnWindow">
            <property name="text"><string>Window (Servo): OFF</string></property>
            <property name="checkable"><bool>true</bool></property>
            <property name="class" stdset="0"><string>toggleBtn</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QPushButton" name="btnDoor">
            <property name="text"><string>Door (LED): OFF</string></property>
            <property name="checkable"><bool>true</bool></property>
            <property name="class" stdset="0"><string>toggleBtn</string></property>
           </widget>
          </item>

          <!-- Fan PWM Control Slider Card -->
          <item row="1" column="0">
           <widget class="QFrame" name="cardFanControl">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout" name="fanCardLayout">
             <item>
              <widget class="QLabel" name="lblFanSpeed">
               <property name="text"><string>Fan Speed (PWM): 0</string></property>
               <property name="class" stdset="0"><string>cardTitle</string></property>
              </widget>
             </item>
             <item>
              <widget class="QSlider" name="sliderFan">
               <property name="maximum"><number>255</number></property>
               <property name="orientation"><enum>Qt::Horizontal</enum></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <item row="1" column="1">
           <widget class="QPushButton" name="btnLight">
            <property name="text"><string>Room Light: OFF</string></property>
            <property name="checkable"><bool>true</bool></property>
            <property name="class" stdset="0"><string>toggleBtn</string></property>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <widget class="QFrame" name="frameLCD">
          <property name="class" stdset="0"><string>card</string></property>
          <layout class="QHBoxLayout" name="lcdLayout">
           <item>
            <widget class="QLabel" name="lblLCD">
             <property name="styleSheet"><string notr="true">color: #FFFFFF; font-weight: bold;</string></property>
             <property name="text"><string>LCD I2C Message:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLineEdit" name="txtLcdMessage">
             <property name="placeholderText">
              <string>Enter text to display on I2C LCD screen...</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnSendLcd">
             <property name="text"><string>Send to LCD</string></property>
             <property name="class" stdset="0"><string>actionBtn</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <spacer name="dashSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- TAB 2: SYSTEM LOGS -->
      <widget class="QWidget" name="tabLogs">
       <attribute name="title">
        <string>System Logs (CSV Data)</string>
       </attribute>
       <layout class="QVBoxLayout" name="logsLayout">
        <item>
         <widget class="QFrame" name="frameFilter">
          <property name="class" stdset="0"><string>card</string></property>
          <layout class="QHBoxLayout" name="filterLayout">
           <item>
            <widget class="QLabel" name="lblDate">
             <property name="styleSheet"><string notr="true">color: #FFFFFF; font-weight: bold;</string></property>
             <property name="text"><string>Date:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QDateEdit" name="datePicker">
             <property name="calendarPopup"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="lblTime">
             <property name="styleSheet"><string notr="true">color: #FFFFFF; font-weight: bold;</string></property>
             <property name="text"><string>Start Time:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QTimeEdit" name="timePicker"/>
           </item>
           <item>
            <widget class="QPushButton" name="btnFilterLogs">
             <property name="text"><string>Filter 1-Hour Window</string></property>
             <property name="class" stdset="0"><string>actionBtn</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnLoadLastHour">
             <property name="text"><string>Load Last 1 Hour</string></property>
             <property name="class" stdset="0"><string>actionBtn</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <widget class="QTableWidget" name="tableLogs">
          <property name="columnCount"><number>16</number></property>
          <column><property name="text"><string>Date</string></property></column>
          <column><property name="text"><string>Time</string></property></column>
          <column><property name="text"><string>Temp</string></property></column>
