            <layout class="QVBoxLayout">
             <item><widget class="QLabel" name="lblT3"><property name="text"><string>Humidity</string></property><property name="class" stdset="0"><string>cardTitle</string></property></widget></item>
             <item><widget class="QLabel" name="lblS3"><property name="text"><string>Sensor: DHT11</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblHumidity"><property name="text"><string>-- %</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
