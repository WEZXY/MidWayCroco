             <item><widget class="QLabel" name="lblS1"><property name="text"><string>Sensor: DHT11</string></property><property name="class" stdset="0"><string>cardSub</string></property></widget></item>
             <item><widget class="QLabel" name="lblTemp"><property name="text"><string>-- °C</string></property><property name="class" stdset="0"><string>cardValue</string></property></widget></item>
            </layout>
           </widget>
          </item>

          <item row="0" column="1">
           <widget class="QFrame" name="cardGas">
            <property name="class" stdset="0"><string>card</string></property>
            <layout class="QVBoxLayout">
